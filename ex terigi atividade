def area_circulo(r):
    pi = 3.14
    area = pi * r * r
    return area


def circunferencia(r):
    pi = 3.14
    c = 2 * pi * r
    return c


def volume_cilindro(r, h):
    pi = 3.14
    v = pi * r * r * h
    return v