def juros_simples(c, taxa, tempo):
    m = c * (1 + taxa * tempo)
    return m


def juros_compostos(c, taxa, tempo):
    montante = c * (1 + taxa) ** tempo
    return montante


def desconto(valor_inicial, desconto):
    final = valor_inicial * (1 - desconto / 100)
    return final


def aumento(valor_inicial, aumento):
    final = valor_inicial * (1 + aumento / 100)
    return final


def parcela(total, qtd):
    p = total / qtd
    return p



















